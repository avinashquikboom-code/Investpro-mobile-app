<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep Android 12+ from showing the launcher icon before Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F8FAF5</item>
        <item name="android:windowSplashScreenBackground">#F8FAF5</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_placeholder</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
